# ===================================================
# KINETIC CINEMA // Configuración de Claves de IA
# ===================================================
# Si estas claves NO están configuradas, el sistema funciona automáticamente
# en modo SIMULADOR CINEMÁTICO de alta fidelidad con narrativas y clips continuos.
# Si ingresas tus claves, el sistema llamará automáticamente a DeepSeek y fal.ai en vivo.

# 1. Clave de DeepSeek (para generación del argumento, biblia de arte y opciones de votación)
# Obtén tu clave en: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 2. Clave de fal.ai (para síntesis de video de 15 segundos con modelos como Wan 2.1 o Minimax)
# Obtén tu clave en: https://fal.ai/dashboard/keys
FAL_KEY=

# ===================================================
# SUPABASE // Base de datos y persistencia en tiempo real
# ===================================================
# Obtén estas credenciales en: https://supabase.com/dashboard/project/<tu-proyecto>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

